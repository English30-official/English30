# English30 environment configuration
# Copy this file to .env for local development. Keep every value empty in this
# committed template and store real values only in local or deployment secrets.

# Required: browser-safe Supabase configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy browser key alias. Leave empty when using the publishable key.
VITE_SUPABASE_ANON_KEY=

# Required: server-side Supabase configuration for access-token verification.
# This must be a publishable/anon key, never the service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required for AI endpoints. Server-only; never prefix this variable with VITE_.
GEMINI_API_KEY=

# Required only while securely claiming the first owner through the Supabase
# Edge Function. Remove the deployed secret after the owner claim succeeds.
OWNER_BOOTSTRAP_EMAIL=

# Supabase Edge Function runtime variables. Supabase provides these automatically
# in deployed functions; local Edge Function development may set them locally.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser or application server.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional application/runtime settings.
NODE_ENV=
PORT=
DISABLE_HMR=

# Optional explicit local-development fallback. Production ignores this flag.
VITE_ENABLE_DEV_FALLBACK=
