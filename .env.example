# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="replace-with-production-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE: Connection credentials for Supabase database & authentication.
# Configured via the Secrets panel or .env file.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"

# Server-only Supabase credentials used to verify access tokens on /api/*.
# Do not expose the service-role key to this application server.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"

# Optional local-only demo fallback. It is ignored by production builds and
# must never be enabled in a deployed environment.
VITE_ENABLE_DEV_FALLBACK="false"

# Supabase Edge Function secret. Set only while bootstrapping the first owner,
# then remove it after the claim succeeds.
OWNER_BOOTSTRAP_EMAIL="owner@example.com"

